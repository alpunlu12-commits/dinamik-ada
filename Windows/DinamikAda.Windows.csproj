<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041 = Windows 10 2004: medya oturumları (GSMTC), Bluetooth ve
         ekran görüntüsünden gizleme (WDA_EXCLUDEFROMCAPTURE) bu sürümden itibaren. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Yalnızca bildirim alanı simgesi ve menüsü için. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <AssemblyName>DinamikAda</AssemblyName>
    <RootNamespace>DinamikAda</RootNamespace>
    <Product>Dinamik Ada</Product>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0</InformationalVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>

    <!-- Linux/macOS'ta da derlenebilsin (CI ve geliştirme için). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WPF uygulaması; DPI farkındalığı app.manifest ile veriliyor. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- Tek dosyalık, .NET kurulumu gerektirmeyen yayın. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ses seviyesi ve değişim bildirimleri (Core Audio). MIT. -->
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- Dahili ekran parlaklığı (WMI). Microsoft. -->
    <PackageReference Include="System.Management" Version="10.0.10" />
    <!-- iCal bağlantısından sıradaki etkinlik, tekrarlayanlar dahil. MIT. -->
    <PackageReference Include="Ical.Net" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

</Project>
